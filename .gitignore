# Local environment and secrets
.env
.env.*
!.env.example
.apikey
.apikey.*
..apikey.swp
.augmentignore
.openaceignore
.codex/
.windsurf/
AGENTS.md
/skills/

# Dependency and build outputs
node_modules/
dist/
build/
coverage/
.cache/
.turbo/

# Python local/build artefacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local test / coverage outputs
*.out
*.prof
*.cover
*.coverprofile

# Runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Root-level local helper scripts are private by default.
# Reusable public automation should live under the owning skill directory.
/scripts/

# Local validation assets
*_test.go
**/tests/
/eval/
*.test.*
*.spec.*
__snapshots__/
**/__snapshots__/

# Private governance outputs and local knowledge assets.
/docs/
**/docs/

# Go build outputs left at repo root by `go build` without -o.
# The published install path is `go install ./cmd/...`, which writes to
# $GOPATH/bin instead, so repo-root .exe files are always local artefacts.
/openpe
/openpe-server
/openpe.exe
/openpe-server.exe
/openpe*.exe~

# Installer UAC elevation scratch (transient per-run wrappers + redirected
# stdout/stderr/result files dropped by the installer when it re-launches
# itself elevated on Windows). The .log siblings are already covered by the
# global *.log rule above; we only need the .ps1 anchor here.
/.openpe-*-elevated.ps1

# Third-party Windsurf-enhance reference clones kept locally for research
# (not part of this project's distributable surface).
/.windsurf-enhance-ref/
/extensions/windsurf-enhance-v1.0.1.zip
