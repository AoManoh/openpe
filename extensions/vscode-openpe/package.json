{
  "name": "vscode-openpe",
  "displayName": "openPE Prompt Manager",
  "description": "Manage openPE prompt enhancement from VS Code compatible IDEs.",
  "version": "0.1.0",
  "publisher": "aomanoh",
  "license": "MIT",
  "icon": "media/openpe-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AoManoh/openpe.git",
    "directory": "extensions/vscode-openpe"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onCommand:openpe.enhancePrompt",
    "onCommand:openpe.enhanceSelection",
    "onCommand:openpe.enhanceCurrentFile",
    "onCommand:openpe.copyLastEnhancedPrompt",
    "onCommand:openpe.insertLastEnhancedPrompt",
    "onCommand:openpe.replaceSelectionWithLastEnhancedPrompt",
    "onCommand:openpe.openLastPreview",
    "onCommand:openpe.configure"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openpe.enhancePrompt",
        "title": "openPE: Enhance Prompt"
      },
      {
        "command": "openpe.enhanceSelection",
        "title": "openPE: Enhance Selection"
      },
      {
        "command": "openpe.enhanceCurrentFile",
        "title": "openPE: Enhance Current File"
      },
      {
        "command": "openpe.copyLastEnhancedPrompt",
        "title": "openPE: Copy Last Enhanced Prompt"
      },
      {
        "command": "openpe.insertLastEnhancedPrompt",
        "title": "openPE: Insert Last Enhanced Prompt"
      },
      {
        "command": "openpe.replaceSelectionWithLastEnhancedPrompt",
        "title": "openPE: Replace Selection With Last Enhanced Prompt"
      },
      {
        "command": "openpe.openLastPreview",
        "title": "openPE: Open Last Preview"
      },
      {
        "command": "openpe.configure",
        "title": "openPE: Open Settings"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "openpe.enhanceSelection",
          "when": "editorHasSelection",
          "group": "navigation@50"
        },
        {
          "command": "openpe.enhanceCurrentFile",
          "when": "editorTextFocus",
          "group": "navigation@51"
        }
      ],
      "commandPalette": [
        {
          "command": "openpe.enhancePrompt"
        },
        {
          "command": "openpe.enhanceSelection"
        },
        {
          "command": "openpe.enhanceCurrentFile"
        },
        {
          "command": "openpe.copyLastEnhancedPrompt"
        },
        {
          "command": "openpe.insertLastEnhancedPrompt"
        },
        {
          "command": "openpe.replaceSelectionWithLastEnhancedPrompt"
        },
        {
          "command": "openpe.openLastPreview"
        },
        {
          "command": "openpe.configure"
        }
      ]
    },
    "configuration": {
      "title": "openPE",
      "properties": {
        "openpe.transport": {
          "type": "string",
          "enum": [
            "cli",
            "http"
          ],
          "default": "cli",
          "description": "How the extension calls openPE. CLI works without a server; HTTP supports richer IDE context."
        },
        "openpe.executablePath": {
          "type": "string",
          "default": "openpe",
          "description": "Path to the openpe executable used when transport is cli."
        },
        "openpe.envFile": {
          "type": "string",
          "default": "",
          "description": "Optional env file path passed to openPE through OPENPE_ENV_FILE."
        },
        "openpe.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18980",
          "description": "openPE HTTP server URL used when transport is http."
        },
        "openpe.client": {
          "type": "string",
          "enum": [
            "vscode",
            "windsurf",
            "cursor",
            "generic"
          ],
          "default": "vscode",
          "description": "Client identity sent to openPE."
        },
        "openpe.defaultMode": {
          "type": "string",
          "default": "agent",
          "description": "Default enhancement mode sent to openPE."
        },
        "openpe.outputMode": {
          "type": "string",
          "enum": [
            "preview",
            "clipboard",
            "insert",
            "replaceSelection"
          ],
          "default": "preview",
          "description": "Default handling for enhanced prompts."
        },
        "openpe.includeActiveFileContext": {
          "type": "boolean",
          "default": false,
          "description": "Include active file content as context when using HTTP transport. CLI transport appends a bounded excerpt to the prompt."
        },
        "openpe.maxContextBytes": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "Maximum bytes of active file content included as IDE context."
        },
        "openpe.templates": {
          "type": "array",
          "default": [],
          "description": "Additional enhancement templates. Each item may contain name, description, mode and prefix.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              }
            }
          }
        },
        "openpe.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Timeout for openPE CLI or HTTP requests."
        }
      }
    }
  },
  "scripts": {
    "build:icon": "python3 scripts/render-icon.py",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.4.2",
    "typescript": "^5.8.3"
  }
}
