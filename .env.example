# =============================================================================
# openPE .env.example
# =============================================================================
# 复制为 ~/.config/openpe/.env （hook 默认加载路径）或项目级 .env 后修改。
# 加载优先级：shell 环境变量 > 此文件。
# =============================================================================

# -----------------------------------------------------------------------------
# 必填（启动 openPE 至少需要这 3 项；缺任一项 provider 调用会失败）
# -----------------------------------------------------------------------------
# OPENAI-compatible 网关 base URL。没有默认值，必须显式填写；
# 不是默认就是 OpenAI 官方，可填阿里云、火山引擎、自建网关等任意兼容地址；
# 带或不带 /v1 结尾都可以。
OPENPE_BASE_URL=https://api.openai.com
# 对应 base URL 的 API key。
OPENPE_API_KEY=replace-with-your-api-key
# 模型名，如 gpt-4o-mini / qwen-max / gpt-5.5 / deepseek-chat 等。
OPENPE_MODEL=replace-with-your-model

# -----------------------------------------------------------------------------
# 可选（有合理默认值，按需覆盖）
# -----------------------------------------------------------------------------
# hook 终端反馈语言。默认 zh，可选 en。
# OPENPE_LANGUAGE=zh

# 单次 provider 调用超时（Go duration: 30s / 1m / 90s）。默认 60s。
# OPENPE_TIMEOUT=60s

# openpe-server 监听地址。默认 127.0.0.1:18980；
# 绑定非 loopback 地址时必须同时设置 OPENPE_SERVER_TOKEN，否则启动会被拒绝。
# OPENPE_LISTEN_ADDR=127.0.0.1:18980

# 全局 token 预算（消费层旋钮，所有客户端共享）。默认 0 = 不限。
# 设为正整数后，enhancer 在拼接最终 prompt 时会按 section 级裁剪
# 可选上下文（history / rules / guidelines / context.files /
# context.retrieval），原始 prompt / 目标客户端 / 工作区 / 增强契约 /
# 收尾指令等 required section 永远保留。一处配置覆盖所有 hook，
# 用于控制单次增强的 token 成本与 provider context window 上限。
# OPENPE_MAX_CONTEXT_TOKENS=8000

# 消息构建结构。默认 flatten：发送 [system, user]，会话历史以 [role] content
# 文本嵌入单条 user 消息（经评测验证的布局）。设为 hybrid：发送
# [system, 历史 user/assistant 真多轮, 末轮 user（仅改写指令+原 prompt）]，
# 角色保真更好、指代消解更强；系统提示会附加「前文仅供参考、勿作答」框架以避免
# 模型续答而非改写。设为 structured：在 hybrid 之上，把 rules/guidelines/
# context.files/retrieval 从任务与对话流中分离为独立「只读参考块」置于历史之前，
# 系统提示用三区框架（参考块/历史/任务）标注；任务消息只留改写指令+原 prompt+本轮元信息。
# hybrid、structured 均为实验性，eval A/B 通过前默认仍为 flatten。
# OPENPE_MESSAGE_STYLE=flatten

# 语言守卫（后处理层）。增强返回前，检测用户输入语言与增强输出语言（CJK/拉丁启发式，
# 检测开销 <1ms）；仅当两者都能明确判定且不一致时才动作，一致（绝大多数情况）为零成本
# 空操作，故向后兼容、不改变原有行为。默认启用。设 false 完全关闭：
# OPENPE_LANGUAGE_GUARD_ENABLED=true
# 不一致时的策略：true = 追加强语言指令后重请求一次（strategy 1，仅此时多一次模型调用），
# 仍失败则保留原输出并在 Warnings 提示可重新生成；false = 只检测并告警、不重试（零额外延迟）。
# OPENPE_LANGUAGE_GUARD_REANCHOR=true

# 模型 provider 协议。默认 openai（OpenAI 兼容 /v1/chat/completions）。设为 anthropic
# 则走 Anthropic Messages API（/v1/messages，用 x-api-key + anthropic-version 头），
# 用于只提供 Anthropic 格式的端点。未设/未知值 → openai，现有配置不受影响。
# OPENPE_PROVIDER=openai
# 模型响应最大 token 数（输出侧上限，区别于 OPENPE_MAX_CONTEXT_TOKENS 的输入预算）。
# Anthropic 必填，0 时回退其默认 4096；OpenAI 忽略（交给网关默认）。
# OPENPE_MAX_TOKENS=0

# 统一注入开关。默认 false = review + 剪贴板（保留 openPE「绝不自动应用、由你粘贴」哲学）。
# 设为 true：增强版作为 additionalContext 注入，代理直接按增强版执行（无需手动粘贴）。
# 已验证 Codex CLI / Claude Code(CLI) / Devin 均消费 UserPromptSubmit additionalContext；
# Windsurf 不支持（开关在 Windsurf 上为无效空操作）。注：Claude 的 VSCode 扩展不消费（仅 CLI 生效）。
# 全局开关 + 每客户端覆盖（每客户端值优先于全局，未设则继承全局，再默认 false）：
# OPENPE_HOOK_INJECT=false
# OPENPE_CODEX_INJECT=true
# OPENPE_CLAUDE_INJECT=true
# OPENPE_DEVIN_INJECT=true

# 系统提示覆盖（可选）。留空则使用内置 enhancer.defaultSystemPrompt。
# 用于在不重新编译的前提下迭代/部署改进版系统提示（如评测选出的版本）。
# 优先级：OPENPE_SYSTEM_PROMPT_FILE（文件内容）> OPENPE_SYSTEM_PROMPT（内联）。
# 文件不存在或为空时回退到内联值，再回退到内置默认。
# OPENPE_SYSTEM_PROMPT_FILE=/etc/openpe/system-prompt.txt
# OPENPE_SYSTEM_PROMPT=You are openPE, a prompt enhancement layer for coding agents. ...

# 多客户端 hook 去重（Devin 场景）。默认启用。
# Devin CLI 会同时加载它自己、Claude Code（~/.claude/*）和 Windsurf
# （~/.codeium/windsurf/hooks.json）的 UserPromptSubmit hook，所以一次 `pe`
# 在 Devin 里会触发已安装的多个 openPE hook。开启后，同一条 prompt 只由最先
# 触发的 hook 增强一次（按 prompt 文本加共享文件锁），其余 hook 直接放行；
# 超过时间窗后再次提交同一 prompt 会重新增强。窗口需略大于“上一个 hook 退出到
# 下一个 hook 启动”的间隔（毫秒级），又要小到不影响有意的重试，默认 5s 足够。
# OPENPE_HOOK_DEDUP_ENABLED=true
# OPENPE_HOOK_DEDUP_WINDOW=5s

# Devin 增强交付方式由上面的「统一注入开关」控制（OPENPE_HOOK_INJECT 全局，或
# OPENPE_DEVIN_INJECT 单独覆盖）。默认 false = 与 Codex/Claude 一致的「拦截 + 剪贴板」：
# 拦截原消息、把增强版复制到剪贴板，由你粘贴/编辑后再发送（openPE 不静默替你提交）；
# 剪贴板不可用时状态会提示 `openpe devin hook last --prompt` 取回。设为 true = 注入：
# 增强版作为 additionalContext 注入、代理自动按增强版执行——仅在你信任增强结果时使用。
# 无论哪种模式，本次增强结果都会缓存可 hook last 取回/审计。（在「统一注入开关」处配置）

# 剪贴板与缓存相关（默认值通常足够，仅在自动探测失败时覆盖）。
# OPENPE_CACHE_DIR=/custom/path/openpe-cache
# 原生 Windows 自定义命令用 cmd.exe /C 执行；POSIX/WSL 用 sh -c 执行。
# WSL 可设为 /mnt/c/Windows/System32/clip.exe；openPE 会对 clip.exe stdin
# 自动写入 UTF-16LE，避免中文被 Windows 剪贴板按本地代码页解码。
# OPENPE_COPY_COMMAND=xclip -selection clipboard
# OPENPE_DISABLE_OSC52_CLIPBOARD=false
# OPENPE_OSC52_TTY=/dev/pts/1
# OPENPE_CLAUDE_PROMPT_FALLBACK=true     # 默认 true
# OPENPE_WINDSURF_PROMPT_FALLBACK=false  # 默认 false

# -----------------------------------------------------------------------------
# 默认已启用（满血提示词增强）— 仅在需要显式关闭时取消注释
# -----------------------------------------------------------------------------
# Codex CLI 本机 session history 注入。默认 true：openPE 会从
# ~/.codex/history.jsonl 反查当前 session id，读取最近 user/assistant
# 消息填入 enhancer.Request.History。非静默：未找到 / cwd 不一致 / 读取失败时
# 都会在 hook 反馈里显式提示「本次未带前文上下文（原因）」，不会静默兜底。
# OPENPE_CODEX_HISTORY_ENABLED=true
# OPENPE_CODEX_HOME=/custom/path/to/.codex
# OPENPE_CODEX_HISTORY_MAX_MESSAGES=12
# OPENPE_CODEX_HISTORY_MAX_CHARS=12000

# Claude Code transcript 注入。默认 true：openPE 读取 Claude hook stdin
# 中的 transcript_path，提取最近 user/assistant 文本消息填入 history。
# 非静默：transcript 缺失 / cwd 不一致 / 读取失败都会显式提示，不静默兜底。
# OPENPE_CLAUDE_TRANSCRIPT_ENABLED=true
# OPENPE_CLAUDE_TRANSCRIPT_MAX_MESSAGES=12
# OPENPE_CLAUDE_TRANSCRIPT_MAX_CHARS=12000

# Devin CLI 本机 session history 注入。默认 true：在 Devin 下运行时，openPE
# 只读 Devin 的 SQLite 会话库（~/.local/share/devin/cli/sessions.db），按
# 工作目录 + 最近活跃定位当前 session，沿 main_chain 重建 user/assistant 历史
# 填入 history。非静默：未找到 / 超出时效窗口 / 读取失败都会显式提示，不静默兜底。
# DB 路径默认按平台解析（Windows 为 %APPDATA%\devin\cli\sessions.db）。
# OPENPE_DEVIN_HISTORY_ENABLED=true
# OPENPE_DEVIN_HISTORY_DB_PATH=/custom/path/to/sessions.db
# OPENPE_DEVIN_HISTORY_MAX_MESSAGES=12
# OPENPE_DEVIN_HISTORY_MAX_CHARS=12000
# 时效窗口：定位到的 session 最近活跃须在窗口内才复用（防同目录旧会话陈旧泄漏）。
# 2026-07 默认由 2h 上调为 6h，覆盖"同日恢复昨晚会话"的延续场景。
# OPENPE_DEVIN_HISTORY_RECENCY=6h

# -----------------------------------------------------------------------------
# 按需启用（高级 / 实验性 / 有前置依赖）
# -----------------------------------------------------------------------------
# --- Openace 代码检索上下文 ---
# 默认关闭。启用前置条件（缺一不可）：
#   1. 本机已运行 openace-mcp daemon（默认 127.0.0.1:8765）；
#   2. 至少有一个 AI 客户端已经接入该 MCP 服务（确保代码域已 index）。
# 详见 https://github.com/AoManoh/openace-mcp
# OPENPE_OPENACE_ENABLED=true
# OPENPE_OPENACE_ADDR=127.0.0.1:8765
# OPENPE_OPENACE_TOKEN=replace-with-openace-daemon-token-if-required
# OPENPE_OPENACE_PROVIDER_PROFILE_ID=primary
# OPENPE_OPENACE_MAX_OUTPUT_LENGTH=12000
# OPENPE_OPENACE_TIMEOUT=30s
# OPENPE_OPENACE_MAX_RETRIES=2
# OPENPE_OPENACE_RETRY_BASE_DELAY=250ms
# OPENPE_OPENACE_RETRY_MAX_DELAY=2s
# OPENPE_OPENACE_RETRY_JITTER=100ms

# --- openpe-server bearer auth ---
# 仅用于 HTTP 调试入口或 Windsurf bundle patch 方案。绑定非 loopback
# 地址时必填；patch 方案推荐固定一个 token 避免每次重启变化。
# OPENPE_SERVER_TOKEN=replace-with-256-bit-hex-token

# --- openpe-server CORS allowlist ---
# 仅在 Electron/webview 客户端跨域调用 server 时需要（如 Windsurf patch）。
# 常用值："null" 对应 file:// webview，"app://windsurf" 对应 Windsurf。
# OPENPE_SERVER_CORS_ORIGINS=null,app://windsurf

# --- openpe-server lifecycle descriptor ---
# 仅 IDE patch installer 需要：openpe-server 启动时写
# ~/.config/openpe/server.json（mode 0600）让 installer 发现 endpoint/token。
# 默认 false；patch 方案必须启用。
# OPENPE_SERVER_LIFECYCLE_ENABLED=true
# OPENPE_SERVER_DESCRIPTOR_FILE=/custom/path/server.json
