# openPE 配置模板
#
# 使用方法：
#   mkdir -p ~/.config/openpe
#   cp .env.example ~/.config/openpe/.env
#   编辑 ~/.config/openpe/.env
#
# 每行格式为 变量名=值；以 # 开头的行是注释，不会生效。
# 加载优先级：shell 环境变量 > OPENPE_ENV_FILE 指向的文件 > 当前目录 .env。
# 参数的实际效果、使用场景和前后对比见 CONFIG.md。

# =============================================================================
# 必填：模型 API
# =============================================================================

# 模型 API 地址。没有默认值，请填写你的实际端点。
OPENPE_BASE_URL=https://your-openai-compatible-endpoint

# 对应端点的 API key。不要把真实 key 提交到 Git。
OPENPE_API_KEY=replace-with-your-api-key

# 模型名称，由你的 API 服务商提供。
OPENPE_MODEL=your-model

# API 协议。默认 openai，调用 /v1/chat/completions。
# 端点使用 /v1/messages 时必须设为 anthropic，否则通常返回 HTTP 404。
# OPENPE_PROVIDER=openai

# Anthropic Messages API 示例：
# OPENPE_PROVIDER=anthropic
# OPENPE_BASE_URL=https://your-anthropic-compatible-endpoint
# OPENPE_API_KEY=replace-with-your-api-key
# OPENPE_MODEL=your-model

# =============================================================================
# 请求与输出
# =============================================================================

# 单次模型调用的最长等待时间。调大可容纳慢响应，调小会更快失败。
# OPENPE_TIMEOUT=60s

# 模型输出上限。Anthropic 下 0 表示使用默认 4096；OpenAI 协议当前忽略该值。
# OPENPE_MAX_TOKENS=0

# 模型输入总预算，包含系统提示、当前任务、历史和参考资料。0 表示不限制。
# 空间不足时先裁剪较旧历史和可选资料；不会静默删除当前任务。
# OPENPE_MAX_CONTEXT_TOKENS=0

# 增强结果的详略：agent 输出较短、适合编码代理执行；human 输出更详细、适合人工阅读。
# OPENPE_PROMPT_STYLE=agent

# 历史和参考资料的发送方式：
# flatten   = 历史作为带角色标签的文本放入一条用户消息，兼容性最好；
# hybrid    = 历史保留为独立 user/assistant 消息，更容易理解“继续上面的方案”；
# structured= 在 hybrid 基础上，把规则、文件和检索结果单独标成只读参考资料。
# hybrid/structured 为实验选项；具体请求结构和效果对比见 CONFIG.md。
# OPENPE_MESSAGE_STYLE=flatten

# 完全替换内置系统提示。文件优先于内联值，也会覆盖 OPENPE_PROMPT_STYLE。
# OPENPE_SYSTEM_PROMPT_FILE=/absolute/path/to/system-prompt.txt
# OPENPE_SYSTEM_PROMPT=Write only the enhanced prompt.

# =============================================================================
# 用户规范（pe+名字 点名加载）
# =============================================================================

# 规范文档目录：pe+<名字> 会读取该目录下 <名字>.md 并逐字追加到增强结果后段。
# 默认 ~/.config/openpe/specs，需要自定义时写绝对路径。
# OPENPE_SPECS_DIR=/absolute/path/to/specs

# 单份规范的字符上限。超限直接报错阻断，不截断。默认 8000。
# OPENPE_SPEC_MAX_CHARS=8000

# =============================================================================
# 状态语言、提醒和语言守卫
# =============================================================================

# openPE 状态信息的语言。只改变提示文案，不强制模型输出语言。
# OPENPE_LANGUAGE=zh

# 检查增强结果中的上下文外数字和用户未要求的高风险动作。只提醒，不改写结果。
# OPENPE_WARNINGS_ENABLED=true

# 增加需要检查的动作词，逗号分隔。
# OPENPE_WARNINGS_ACTIONS=truncate,migrate

# 只检查不超过该长度的数字串，避免把长 ID 或哈希当成普通数字。默认 5。
# OPENPE_WARNINGS_NUM_MAXLEN=5

# 检测输出是否明显偏离输入的主导语言。混合文本没有主导语言时不动作。
# OPENPE_LANGUAGE_GUARD_ENABLED=true

# 发现明确语言偏移时是否额外调用一次模型修正。
# true = 最多额外调用一次；false = 只显示提醒，不额外调用。
# OPENPE_LANGUAGE_GUARD_REANCHOR=true

# =============================================================================
# Review、注入、缓存和剪贴板
# =============================================================================

# 默认 false：阻断原始 pe、复制增强结果，由用户检查后发送。
# true：Codex、Claude Code、Devin 直接收到增强结果；Windsurf 不支持注入。
# OPENPE_HOOK_INJECT=false

# 客户端值会覆盖全局 OPENPE_HOOK_INJECT。
# OPENPE_CODEX_INJECT=false
# OPENPE_CLAUDE_INJECT=false
# OPENPE_DEVIN_INJECT=false

# 缓存根目录。openPE 会自动追加 codex/claude/devin/windsurf 子目录。
# OPENPE_CACHE_DIR=/custom/path/openpe-cache

# 覆盖自动检测的剪贴板命令。命令从 stdin 读取增强提示词。
# OPENPE_COPY_COMMAND=xclip -selection clipboard

# 禁用 OSC52 终端剪贴板回退。IDE 子进程或不支持 OSC52 的终端可设为 true。
# OPENPE_DISABLE_OSC52_CLIPBOARD=false

# OSC52 写入目标。只在自动检测到的 TTY 不正确时修改。
# OPENPE_OSC52_TTY=/dev/tty

# 剪贴板失败时，是否在客户端反馈中显示完整增强提示词。
# OPENPE_CLAUDE_PROMPT_FALLBACK=true
# OPENPE_WINDSURF_PROMPT_FALLBACK=false

# Devin 整个 hook 的自我截止时间。必须为正数；安装器还会根据宿主 timeout 设置更短上限。
# OPENPE_HOOK_DEADLINE=100s

# =============================================================================
# 会话历史
# =============================================================================

# Codex：从本地 history 和 rollout 读取最近的 user/assistant 消息。
# OPENPE_CODEX_HISTORY_ENABLED=true
# OPENPE_CODEX_HOME=/custom/path/to/.codex
# OPENPE_CODEX_HISTORY_MAX_MESSAGES=12
# OPENPE_CODEX_HISTORY_MAX_CHARS=12000

# Claude Code：从 hook 提供的 transcript_path 读取最近消息。
# OPENPE_CLAUDE_TRANSCRIPT_ENABLED=true
# OPENPE_CLAUDE_TRANSCRIPT_MAX_MESSAGES=12
# OPENPE_CLAUDE_TRANSCRIPT_MAX_CHARS=12000

# Devin：Linux 上优先识别当前 session；识别失败时按工作目录和最近活跃时间回退。
# OPENPE_DEVIN_HISTORY_ENABLED=true
# OPENPE_DEVIN_HISTORY_DB_PATH=/custom/path/to/sessions.db
# OPENPE_DEVIN_HISTORY_MAX_MESSAGES=12
# OPENPE_DEVIN_HISTORY_MAX_CHARS=12000

# 仅限制 Devin 无法精确识别 session 时的回退路径。调大可使用更早的 session，
# 也会增加复用同目录陈旧会话的可能。Linux 精确识别成功时不受该值限制。
# OPENPE_DEVIN_HISTORY_RECENCY=6h

# Devin 可能同时运行 Devin 格式和 Claude Code 格式的 openPE hook。
# 开启后只调用一次模型；review 模式重放同一阻断结果，注入模式避免重复注入。
# OPENPE_HOOK_DEDUP_ENABLED=true

# 多 hook 被视为同一次提交的时间窗口。过小可能重复调用，过大可能复用用户有意重试的结果。
# OPENPE_HOOK_DEDUP_WINDOW=5s

# =============================================================================
# 本地 HTTP server / 实验性 IDE patch
# =============================================================================

# openpe-server 只允许 loopback。0.0.0.0、LAN IP 和其它主机名会启动失败。
# OPENPE_LISTEN_ADDR=127.0.0.1:18980

# 为 /v1/* 启用 bearer 认证。lifecycle 模式要求 64 位小写十六进制。
# OPENPE_SERVER_TOKEN=replace-with-64-lowercase-hex-characters

# 允许调用本地 server 的浏览器/Electron Origin，逗号分隔。
# 只添加客户端实际报告的 Origin；普通 hook、CLI 和 curl 不需要 CORS。
# OPENPE_SERVER_CORS_ORIGINS=vscode-file://vscode-app

# server 成功监听后写 descriptor，供实验性 IDE patch installer 发现地址和 token。
# 普通 hook 不需要开启。
# OPENPE_SERVER_LIFECYCLE_ENABLED=false

# descriptor 路径覆盖。默认 ~/.config/openpe/server.json。
# OPENPE_SERVER_DESCRIPTOR_FILE=/custom/path/server.json

# =============================================================================
# Openace（已废弃，默认关闭，仅为已有部署保留）
# =============================================================================

# OPENPE_OPENACE_ENABLED=false
# OPENPE_OPENACE_ADDR=127.0.0.1:8765
# OPENPE_OPENACE_TOKEN=replace-with-openace-daemon-token-if-required
# OPENPE_OPENACE_PROVIDER_PROFILE_ID=primary
# OPENPE_OPENACE_MAX_OUTPUT_LENGTH=12000
# OPENPE_OPENACE_TIMEOUT=30s
# OPENPE_OPENACE_MAX_RETRIES=2
# OPENPE_OPENACE_RETRY_BASE_DELAY=250ms
# OPENPE_OPENACE_RETRY_MAX_DELAY=2s
# OPENPE_OPENACE_RETRY_JITTER=100ms
