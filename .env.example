# OpenAI-compatible provider configuration.
OPENPE_BASE_URL=https://api.openai.com
OPENPE_API_KEY=replace-with-your-api-key
OPENPE_MODEL=replace-with-your-model
OPENPE_LANGUAGE=zh

# HTTP server configuration.
OPENPE_LISTEN_ADDR=127.0.0.1:18980
OPENPE_TIMEOUT=60s
# Optional bearer-token authentication for openpe-server. When set, all
# requests to /v1/* must include `Authorization: Bearer <token>`; /healthz
# is always exempt. Leave commented out to preserve the historical no-auth
# behaviour (still safe on loopback when no other local user is trusted).
# OPENPE_SERVER_TOKEN=replace-with-256-bit-hex-token
# Optional comma-separated Origin allowlist for CORS handling. Required when
# Electron / webview clients (Windsurf, Cursor, VS Code Composer) call the
# server cross-origin. Common values: "null" for file:// webviews,
# "app://windsurf", "vscode-webview://...". Use "*" only when bearer auth
# is also enabled. Empty disables CORS entirely (default).
# OPENPE_SERVER_CORS_ORIGINS=null,app://windsurf

# Optional Openace code retrieval context provider.
# Disabled by default; when enabled, openPE calls the local Openace daemon before prompt rewrite.
OPENPE_OPENACE_ENABLED=false
OPENPE_OPENACE_ADDR=127.0.0.1:8765
# OPENPE_OPENACE_TOKEN=replace-with-openace-daemon-token-if-required
# OPENPE_OPENACE_PROVIDER_PROFILE_ID=primary
OPENPE_OPENACE_MAX_OUTPUT_LENGTH=12000
OPENPE_OPENACE_TIMEOUT=30s
OPENPE_OPENACE_MAX_RETRIES=2
OPENPE_OPENACE_RETRY_BASE_DELAY=250ms
OPENPE_OPENACE_RETRY_MAX_DELAY=2s
OPENPE_OPENACE_RETRY_JITTER=100ms
